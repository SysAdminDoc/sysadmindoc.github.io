{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/csp-report" } },
          { "not": { "href_matches": "/og/*" } },
          { "not": { "selector_matches": "[rel~=nofollow]" } },
          { "not": { "selector_matches": "[download]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
