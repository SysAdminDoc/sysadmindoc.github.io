---
import { greatestHits } from '../data/curated';
import { githubRepoUrl } from '../data/github';

export interface Props {
  limit?: number;
}

const { limit = greatestHits.length } = Astro.props;
const selectedHits = greatestHits.slice(0, Math.max(0, limit));
---
<section id="greatest-hits" class="selected-work" aria-labelledby="selected-work-title">
  <div class="si">
    <header class="selected-work-head rv">
      <div>
        <span class="selected-work-index">01 / Work</span>
        <h2 id="selected-work-title">Selected work</h2>
      </div>
      <p>Three projects that show the range without asking you to scan the entire archive.</p>
    </header>
    <div class="selected-work-list">
      {selectedHits.map((hit, index) => (
        <a href={githubRepoUrl(hit.repo)} target="_blank" rel="noopener" class="selected-work-row card-enter" data-repo={hit.repo}>
          <span class="selected-work-rank">{String(index + 1).padStart(2, '0')}</span>
          <span class="selected-work-name">
            <strong>{hit.name}</strong>
            <small>{hit.tag}</small>
          </span>
          <span class="selected-work-why">{hit.why}</span>
          <span class="selected-work-action">Repository <i aria-hidden="true">↗</i></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .selected-work{
    padding:clamp(84px,9vw,124px) 32px;
    border-bottom:1px solid var(--border-soft);
    background:var(--bg);
  }
  .si{
    width:min(1180px,100%);
    max-width:none;
    margin:0 auto;
    padding:0;
  }
  .selected-work-head{
    display:grid;
    grid-template-columns:minmax(0,1.1fr) minmax(300px,.7fr);
    gap:64px;
    align-items:end;
    margin-bottom:56px;
  }
  .selected-work-index{
    display:block;
    margin-bottom:18px;
    color:var(--org);
    font-family:var(--mono);
    font-size:10px;
    font-weight:700;
    letter-spacing:.15em;
    text-transform:uppercase;
  }
  .selected-work h2{
    margin:0;
    color:var(--t1);
    font-size:clamp(42px,5.5vw,72px);
    font-weight:620;
    line-height:.95;
    letter-spacing:-.058em;
  }
  .selected-work-head p{
    max-width:500px;
    margin:0;
    color:var(--t2);
    font-size:16px;
    line-height:1.72;
  }
  .selected-work-list{border-top:1px solid var(--border-strong)}
  .selected-work-row{
    display:grid;
    grid-template-columns:54px minmax(210px,.68fr) minmax(0,1fr) 112px;
    gap:28px;
    align-items:start;
    min-height:0;
    padding:30px 0;
    border:0;
    border-bottom:1px solid var(--border-soft);
    border-radius:0;
    background:transparent;
    box-shadow:none;
    color:inherit;
    text-decoration:none;
    transform:none;
  }
  .selected-work-row:hover,
  .selected-work-row:focus-visible{
    border-color:var(--border-strong);
    background:transparent;
    box-shadow:none;
    transform:none;
  }
  .selected-work-row:focus-visible{outline:2px solid var(--focus-outline);outline-offset:6px}
  .selected-work-rank{
    color:var(--org);
    font-family:var(--mono);
    font-size:11px;
    font-weight:700;
    letter-spacing:.12em;
  }
  .selected-work-name{
    display:flex;
    min-width:0;
    flex-direction:column;
    gap:8px;
  }
  .selected-work-name strong{
    color:var(--t1);
    font-size:21px;
    font-weight:650;
    letter-spacing:-.025em;
    overflow-wrap:anywhere;
  }
  .selected-work-name small{
    color:var(--t3);
    font-family:var(--mono);
    font-size:10px;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
  .selected-work-why{
    color:var(--t2);
    font-size:15px;
    line-height:1.68;
  }
  .selected-work-action{
    color:var(--t1);
    font-family:var(--mono);
    font-size:10px;
    font-weight:700;
    letter-spacing:.08em;
    text-align:right;
    text-transform:uppercase;
  }
  .selected-work-action i{
    display:inline-block;
    margin-left:7px;
    color:var(--blue);
    font-style:normal;
    transition:transform .2s ease-out;
  }
  .selected-work-row:hover .selected-work-action i,
  .selected-work-row:focus-visible .selected-work-action i{transform:translate(3px,-3px)}
  @media(max-width:860px){
    .selected-work-head{grid-template-columns:1fr;gap:24px}
    .selected-work-row{grid-template-columns:42px minmax(180px,.65fr) minmax(0,1fr);gap:18px}
    .selected-work-action{grid-column:2;text-align:left}
  }
  @media(max-width:640px){
    .selected-work{padding:72px 18px}
    .selected-work-head{margin-bottom:38px}
    .selected-work h2{font-size:44px}
    .selected-work-row{
      grid-template-columns:30px minmax(0,1fr);
      gap:12px 14px;
      padding:24px 0;
    }
    .selected-work-why,
    .selected-work-action{grid-column:2}
  }
</style>
