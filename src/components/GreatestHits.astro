---
import { greatestHits } from '../data/curated';
import { githubRepoUrl } from '../data/github';

export interface Props {
  limit?: number;
}

const { limit = greatestHits.length } = Astro.props;
const selectedHits = greatestHits.slice(0, Math.max(0, limit));
---
<section id="greatest-hits" class="selected-work" aria-labelledby="selected-work-title">
  <div class="si">
    <header class="selected-work-head">
      <div>
        <span class="selected-work-index">Selected work</span>
        <h2 id="selected-work-title">A few things I'm proud of.</h2>
      </div>
      <div class="selected-work-intro">
        <p>I build tools for problems where the commercial option doesn't exist, costs too much, or phones home. These are some of my favorites.</p>
        <a href="/work/" class="selected-work-more">Read the case studies <i aria-hidden="true">→</i></a>
      </div>
    </header>
    <div class="selected-work-list">
      {selectedHits.map((hit, index) => (
        <a href={githubRepoUrl(hit.repo)} target="_blank" rel="noopener" class="selected-work-row" data-repo={hit.repo}>
          <span class="selected-work-top">
            <span class="selected-work-rank">{String(index + 1).padStart(2, '0')}</span>
            <small class="selected-work-tag">{hit.tag}</small>
          </span>
          <strong class="selected-work-name">{hit.name}</strong>
          <span class="selected-work-why">{hit.why}</span>
          <span class="selected-work-action">View on GitHub <i aria-hidden="true">↗</i></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .selected-work{
    padding:32px 32px 96px;
    border:0;
    background:transparent;
  }
  .si{
    width:min(var(--content-max,1240px),100%);
    max-width:none;
    margin:0 auto;
    padding:0;
  }
  .selected-work-head{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(280px,440px);
    gap:24px 48px;
    align-items:end;
    margin-bottom:28px;
  }
  .selected-work-index{
    display:block;
    margin-bottom:18px;
    color:var(--blue);
    font-family:var(--sans);
    font-size:12px;
    font-weight:600;
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  .selected-work h2{
    max-width:24ch;
    margin:0;
    color:var(--t1);
    font-size:clamp(34px,3.3vw,46px);
    font-weight:650;
    line-height:1.06;
    letter-spacing:-.022em;
  }
  .selected-work-head p{
    max-width:46ch;
    margin:0;
    color:var(--t2);
    font-size:15px;
    line-height:1.55;
  }
  .selected-work-list{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:24px;
  }
  /* The first visible projects render immediately, with motion kept to hover. */
  #greatest-hits .selected-work-row{
    display:flex;
    min-width:0;
    min-height:0;
    flex-direction:column;
    gap:14px;
    padding:28px;
    border:1px solid var(--border-soft);
    border-radius:12px;
    background:var(--surface-1);
    box-shadow:var(--edge),var(--shadow-sm);
    color:inherit;
    text-decoration:none;
    transition:opacity .5s var(--ease-out,ease-out),transform var(--dur-base,.25s) var(--ease-out,ease-out),border-color var(--dur-base,.25s) var(--ease-out,ease-out),box-shadow var(--dur-base,.25s) var(--ease-out,ease-out);
  }
  #greatest-hits .selected-work-row:hover,
  #greatest-hits .selected-work-row:focus-visible{
    border-color:var(--border-hover);
    background:var(--surface-1);
    box-shadow:var(--edge),var(--shadow-lg);
    transform:translateY(-4px);
  }
  #greatest-hits .selected-work-row:focus-visible{outline:2px solid var(--focus-outline);outline-offset:3px}
  .selected-work-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-bottom:6px;
  }
  .selected-work-rank{
    color:var(--t3);
    font-family:var(--sans);
    font-size:13px;
    font-weight:600;
    font-variant-numeric:tabular-nums;
    letter-spacing:.04em;
  }
  .selected-work-tag{
    padding:4px 8px;
    border:1px solid var(--border-soft);
    border-radius:6px;
    color:var(--t2);
    font-family:var(--sans);
    font-size:11px;
    font-weight:600;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
  .selected-work-name{
    color:var(--t1);
    font-size:22px;
    font-weight:650;
    line-height:1.2;
    letter-spacing:-.02em;
    overflow-wrap:anywhere;
  }
  .selected-work-why{
    flex:1;
    color:var(--t2);
    font-size:15px;
    line-height:1.65;
  }
  .selected-work-action{
    display:inline-flex;
    align-items:center;
    gap:6px;
    margin-top:8px;
    padding-top:18px;
    border-top:1px solid var(--border-soft);
    color:var(--blue);
    font-size:14px;
    font-weight:600;
  }
  .selected-work-action i{
    display:inline-block;
    font-style:normal;
    transition:transform var(--dur-fast,.18s) var(--ease-out,ease-out);
  }
  #greatest-hits .selected-work-row:hover .selected-work-action i,
  #greatest-hits .selected-work-row:focus-visible .selected-work-action i{transform:translate(2px,-2px)}
  .selected-work-more{
    display:inline-flex;
    align-items:center;
    gap:8px;
    min-height:44px;
    margin-top:6px;
    color:var(--blue);
    font-family:var(--sans);
    font-size:14px;
    font-weight:600;
    text-decoration:none;
  }
  .selected-work-more i{font-style:normal}
  .selected-work-more:hover,
  .selected-work-more:focus-visible{text-decoration:underline;text-underline-offset:5px}
  @media(prefers-reduced-motion:reduce){
    #greatest-hits .selected-work-row:hover,
    #greatest-hits .selected-work-row:focus-visible{transform:none}
  }
  @media(max-width:1080px){
    .selected-work-list{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:860px){
    .selected-work-head{grid-template-columns:1fr;gap:16px}
  }
  @media(max-width:640px){
    .selected-work{padding:72px 18px}
    .selected-work-head{margin-bottom:32px}
    .selected-work h2{font-size:34px}
    .selected-work-list{grid-template-columns:1fr;gap:16px}
    #greatest-hits .selected-work-row{padding:22px}
  }
</style>
