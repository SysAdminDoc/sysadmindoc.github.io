---
import Base from '../layouts/Base.astro';
import LiveCard from '../components/LiveCard.astro';
import GreatestHits from '../components/GreatestHits.astro';
import Footer from '../components/Footer.astro';
import { catalog, liveApps } from '../data/portfolio';
import { contactEmail, contactMailto } from '../data/identity';
import { careerLanes, careerProfile, careerProof } from '../data/career';

let avatarUrl = 'https://avatars.githubusercontent.com/u/55504284';
try {
  const mod = await import('../data/_stats.json');
  avatarUrl = (mod.default ?? mod).avatarUrl || avatarUrl;
} catch {}

const livePreview = liveApps.slice(0, 2);
const publicProjectCount = catalog.length;
const contactPaths = [
  {
    label: 'Email',
    value: contactEmail,
    href: contactMailto(),
    external: false,
  },
  {
    label: 'GitHub',
    value: 'SysAdminDoc',
    href: 'https://github.com/SysAdminDoc',
    external: true,
  },
  {
    label: 'LinkedIn',
    value: 'Matthew Ryan Parker',
    href: 'https://www.linkedin.com/in/matthewryanparker',
    external: true,
  },
] as const;

const cmdkSections = [
  { label: 'Selected Work', href: '#greatest-hits', desc: 'Three representative public projects.', badge: 'START' },
  { label: 'Live Apps', href: '#live', desc: 'A small preview of browser-ready work.', badge: 'LIVE' },
  { label: 'Practice', href: '#skills', desc: 'AI implementation, healthcare systems, and infrastructure.', badge: 'SECTION' },
  { label: 'Project Catalog', href: '/catalog/', desc: 'Browse the complete public project archive.', badge: 'ARCHIVE' },
  { label: 'AI Services', href: '/ai/', desc: 'Implementation, workflow automation, training, and ongoing support.', badge: 'TRACK' },
  { label: 'Resume', href: '/resume/', desc: 'Career history, skills, and experience.', badge: 'PAGE' },
  { label: 'Contact', href: '#connect', desc: 'Email and professional profiles.', badge: 'SECTION' },
] as const;
---
<Base cmdkSections={cmdkSections}>
  <a href="#main" class="skip-link">Skip to content</a>

  <nav id="nav" aria-label="Main navigation">
    <div class="ni">
      <a href="#hero" class="nl" aria-label="SysAdminDoc home">
        <span class="brand-mark" aria-hidden="true">MP</span>
        <span class="brand-copy">
          <strong>SysAdminDoc</strong>
          <small>AI · Healthcare · Systems</small>
        </span>
      </a>
      <div class="nk" id="navLinks">
        <a href="#greatest-hits">Work</a>
        <a href="#skills">Practice</a>
        <a href="/ai/">AI</a>
        <a href="/resume/">Resume</a>
        <a href="#connect">Contact</a>
        <div class="nav-indicator" id="navIndicator"></div>
      </div>
      <div class="nav-actions">
        <button type="button" class="theme-toggle" id="themeToggle" aria-label="Switch to light theme" title="Switch to light theme">
          <svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>
        <button type="button" class="nav-search" id="cmdkToggle" aria-label="Open command search" aria-controls="cmdk" aria-expanded="false" aria-haspopup="dialog" title="Open command search">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <button type="button" class="mt" id="mobileToggle" aria-label="Open navigation menu" aria-controls="navLinks" aria-expanded="false" title="Open navigation menu">
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
  </nav>
  <div class="nav-backdrop" id="navBackdrop" aria-hidden="true"></div>
  <div class="scroll-progress" id="scrollProgress"></div>

  <main id="main" data-pagefind-body data-pagefind-filter="Scope:Home">
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="route_type:Home"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="type:Home"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="category:Portfolio"></span>

    <section class="hero minimal-hero" id="hero">
      <div class="hi">
        <div class="ht">
          <p class="hero-eyebrow">Independent technical practice</p>
          <div class="hero-identity h-card">
            <img class="hero-avatar loaded u-photo" id="heroAvatar" src={avatarUrl} alt="Matt Parker" width="72" height="72" decoding="async" fetchpriority="high">
            <h1 class="hn p-name">Matt <span class="a">Parker</span></h1>
            <a class="u-url" href="/" hidden>Matt Parker</a>
          </div>
          <p class="hr">{careerProfile.headline}</p>
          <p class="hero-summary">{careerProfile.operatingNote}</p>
          <div class="ha">
            <a href="#greatest-hits" class="btn bp">View selected work <span aria-hidden="true">↓</span></a>
            <a href="/ai/" class="btn bg2">Explore AI services <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="hs hero-proof-strip" role="group" aria-label="Experience and portfolio proof">
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl">{careerProof[0].label}</span>
            <strong class="hero-proof-value hsn">{careerProof[0].value}</strong>
            <span class="hero-proof-copy">{careerProof[0].detail}</span>
          </div>
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl">Public execution</span>
            <strong class="hero-proof-value hsn"><span id="statRepos">{publicProjectCount}</span><sup>+</sup> projects</strong>
            <span class="hero-proof-copy">Software delivered in public</span>
          </div>
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl">Live proof</span>
            <strong class="hero-proof-value hsn"><span id="statLive">{liveApps.length}</span> live apps</strong>
            <span class="hero-proof-copy">Working output available online</span>
          </div>
        </div>
      </div>
    </section>

    <GreatestHits limit={3} />

    <section id="live" class="home-section home-live" aria-labelledby="live-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">02 / Live</span>
            <h2 id="live-title">Working, not hypothetical.</h2>
          </div>
          <div class="home-section-intro">
            <p>A small sample of browser-ready products. The full visual archive stays one click away.</p>
            <a href="/screenshots/" class="text-link">View all live evidence <span aria-hidden="true">→</span></a>
          </div>
        </header>
        <div class="home-live-grid">
          {livePreview.map((app) => <LiveCard app={app} />)}
        </div>
      </div>
    </section>

    <section id="skills" class="home-section home-practice" aria-labelledby="practice-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">03 / Practice</span>
            <h2 id="practice-title">One operator. Three connected lanes.</h2>
          </div>
          <p class="home-section-intro">The work spans implementation, operations, and the practical software between them.</p>
        </header>
        <div class="hero-evidence hero-operating-index practice-list">
          {careerLanes.map((lane, index) => (
            <a href={lane.href} class="practice-row">
              <span class="practice-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="practice-name">
                <strong>{lane.name}</strong>
                <small>{lane.short}</small>
              </span>
              <span class="practice-focus">{lane.focus}</span>
              <span class="practice-action" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="catalog" class="home-section home-catalog-handoff" aria-labelledby="catalog-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">04 / Explore</span>
            <h2 id="catalog-title">The complete record, when you need it.</h2>
          </div>
          <p class="home-section-intro">{publicProjectCount} public projects remain available without turning the homepage into a database.</p>
        </header>
        <nav class="handoff-links" aria-label="Project discovery">
          <a href="/catalog/"><span>Browse every project</span><strong>Catalog</strong><i aria-hidden="true">→</i></a>
          <a href="/search/"><span>Find a specific topic</span><strong>Search</strong><i aria-hidden="true">→</i></a>
          <a href="/releases/"><span>See what shipped</span><strong>Releases</strong><i aria-hidden="true">→</i></a>
        </nav>
      </div>
    </section>

    <section id="connect" class="home-section home-contact" aria-labelledby="contact-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">05 / Contact</span>
            <h2 id="contact-title">Start with a useful conversation.</h2>
          </div>
          <p class="home-section-intro">For implementation work, technical collaboration, or a role where operating discipline matters.</p>
        </header>
        <div class="contact-list">
          {contactPaths.map((path) => (
            <a href={path.href} target={path.external ? '_blank' : undefined} rel={path.external ? 'noopener' : undefined}>
              <span>{path.label}</span>
              <strong>{path.value}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer
    variant="home"
    summary="AI implementation, healthcare systems, and practical software—built, documented, and operated by Matt Parker."
    links={[
      { href: '/catalog/', label: 'Projects' },
      { href: '/ai/', label: 'AI services' },
      { href: '/resume/', label: 'Resume' },
      { href: 'https://github.com/SysAdminDoc', label: 'GitHub', external: true },
    ]}
  />
</Base>

<style>
  :global(body.route-home) .minimal-hero{
    min-height:0;
    padding:clamp(138px,15vw,184px) 32px clamp(88px,10vw,128px);
    border-bottom:1px solid var(--border-soft);
    background:var(--bg);
    overflow:visible;
  }
  :global(body.route-home) .minimal-hero::before,
  :global(body.route-home) .minimal-hero::after{display:none}
  :global(body.route-home) .minimal-hero .hi{
    display:block;
    width:min(1180px,100%);
    max-width:none;
    min-height:0;
    margin:0 auto;
    padding:0;
  }
  :global(body.route-home) .minimal-hero .ht{
    display:block!important;
    max-width:920px;
    padding:42px 0 0!important;
    border:0!important;
  }
  :global(body.route-home) .minimal-hero .hero-eyebrow{
    margin:0 0 34px;
    color:var(--org);
    font-family:var(--mono);
    font-size:11px;
    font-weight:700;
    letter-spacing:.16em;
    text-transform:uppercase;
  }
  :global(body.route-home) .minimal-hero .hero-identity{
    display:flex;
    align-items:center;
    gap:24px;
  }
  :global(body.route-home) .minimal-hero .hero-avatar{
    width:68px;
    height:68px;
    border:1px solid var(--border-soft);
    border-radius:50%;
    box-shadow:none;
  }
  :global(body.route-home) .minimal-hero .hn{
    max-width:none;
    margin:0;
    color:var(--t1);
    font-size:clamp(64px,8.5vw,116px);
    font-weight:650;
    line-height:.88;
    letter-spacing:-.072em;
  }
  :global(body.route-home) .minimal-hero .hn .a{color:var(--t1)}
  :global(body.route-home) .minimal-hero .hr{
    max-width:800px;
    margin:38px 0 0;
    color:var(--t2);
    font-size:clamp(20px,2.25vw,29px);
    font-weight:500;
    line-height:1.38;
    letter-spacing:-.025em;
  }
  :global(body.route-home) .minimal-hero .hero-summary{
    max-width:660px;
    margin:22px 0 0;
    color:var(--t3);
    font-size:17px;
    line-height:1.75;
  }
  :global(body.route-home) .minimal-hero .ha{margin-top:36px}
  :global(body.route-home) .minimal-hero .hero-proof-strip{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    width:100%;
    margin:clamp(70px,8vw,104px) 0 0;
    border-block:1px solid var(--border-soft);
    background:transparent;
  }
  :global(body.route-home) .minimal-hero .hero-proof{
    display:flex;
    min-width:0;
    min-height:0;
    padding:25px 28px;
    flex-direction:column;
    align-items:flex-start;
    gap:8px;
    border:0;
    border-left:1px solid var(--border-soft);
    border-radius:0;
    background:transparent;
    box-shadow:none;
  }
  :global(body.route-home) .minimal-hero .hero-proof:first-child{border-left:0}
  :global(body.route-home) .minimal-hero .hero-proof-label{
    color:var(--t3);
    font-family:var(--mono);
    font-size:10px;
    font-weight:700;
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  :global(body.route-home) .minimal-hero .hero-proof-value{
    color:var(--t1);
    font-family:var(--sans);
    font-size:22px;
    font-weight:650;
    letter-spacing:-.025em;
  }
  :global(body.route-home) .minimal-hero .hero-proof-value sup{
    position:static;
    color:inherit;
    font-size:.65em;
  }
  :global(body.route-home) .minimal-hero .hero-proof-copy{
    color:var(--t3);
    font-size:13px;
    line-height:1.5;
  }
  :global(body.route-home) .home-section{
    padding:clamp(84px,9vw,124px) 32px;
    border-bottom:1px solid var(--border-soft);
    background:var(--bg);
  }
  :global(body.route-home) .home-shell{
    width:min(1180px,100%);
    margin:0 auto;
  }
  :global(body.route-home) .home-section-head{
    display:grid;
    grid-template-columns:minmax(0,1.1fr) minmax(300px,.7fr);
    gap:64px;
    align-items:end;
    margin-bottom:56px;
  }
  :global(body.route-home) .home-section-index{
    display:block;
    margin-bottom:18px;
    color:var(--org);
    font-family:var(--mono);
    font-size:10px;
    font-weight:700;
    letter-spacing:.15em;
    text-transform:uppercase;
  }
  :global(body.route-home) .home-section h2{
    max-width:720px;
    margin:0;
    color:var(--t1);
    font-size:clamp(37px,4.8vw,66px);
    font-weight:620;
    line-height:1;
    letter-spacing:-.055em;
  }
  :global(body.route-home) .home-section-intro{
    max-width:500px;
    margin:0;
    color:var(--t2);
    font-size:16px;
    line-height:1.72;
  }
  :global(body.route-home) .home-section-intro p{margin:0 0 16px}
  :global(body.route-home) .text-link{
    display:inline-flex;
    min-height:40px;
    padding-block:8px;
    align-items:center;
    color:var(--t1);
    font-family:var(--mono);
    font-size:11px;
    font-weight:700;
    letter-spacing:.08em;
    text-decoration:none;
    text-transform:uppercase;
  }
  :global(body.route-home) .home-live-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:54px 30px;
  }
  :global(body.route-home) .home-live-grid :global(.lc2){
    min-width:0;
    padding:0;
    border:0;
    border-radius:0;
    background:transparent;
    box-shadow:none;
    transform:none;
  }
  :global(body.route-home) .home-live-grid :global(.lc2:hover){
    border-color:transparent;
    box-shadow:none;
    transform:none;
  }
  :global(body.route-home) .home-live-grid :global(.lc2-thumb){
    margin:0 0 22px;
    border:1px solid var(--border-soft);
    border-radius:2px;
    background:var(--surface-1);
    box-shadow:none;
  }
  :global(body.route-home) .home-live-grid :global(.lct){padding:0}
  :global(body.route-home) .home-live-grid :global(.lcd){padding:10px 0 0}
  :global(body.route-home) .home-live-grid :global(.lc2-foot){
    margin-top:18px;
    padding:16px 0 0;
    border-top:1px solid var(--border-soft);
  }
  :global(body.route-home) .practice-list{
    width:100%;
    max-width:none;
    margin:0!important;
    padding:0!important;
    border-top:1px solid var(--border-strong);
    border-radius:0;
    background:transparent;
    box-shadow:none;
  }
  :global(body.route-home) .practice-row{
    display:grid;
    grid-template-columns:54px minmax(210px,.7fr) minmax(0,1.35fr) 24px;
    gap:28px;
    align-items:start;
    padding:30px 0;
    border-bottom:1px solid var(--border-soft);
    color:inherit;
    text-decoration:none;
  }
  :global(body.route-home) .practice-row:hover .practice-action,
  :global(body.route-home) .practice-row:focus-visible .practice-action{transform:translate(3px,-3px)}
  :global(body.route-home) .practice-row:focus-visible{outline:2px solid var(--focus-outline);outline-offset:6px}
  :global(body.route-home) .practice-index{
    color:var(--org);
    font-family:var(--mono);
    font-size:11px;
    font-weight:700;
    letter-spacing:.12em;
  }
  :global(body.route-home) .practice-name{
    display:flex;
    flex-direction:column;
    gap:7px;
  }
  :global(body.route-home) .practice-name strong{
    color:var(--t1);
    font-size:19px;
    font-weight:650;
    letter-spacing:-.02em;
  }
  :global(body.route-home) .practice-name small{
    color:var(--t3);
    font-family:var(--mono);
    font-size:10px;
    letter-spacing:.06em;
    text-transform:uppercase;
  }
  :global(body.route-home) .practice-focus{
    color:var(--t2);
    font-size:15px;
    line-height:1.65;
  }
  :global(body.route-home) .practice-action{
    color:var(--blue);
    font-size:18px;
    font-style:normal;
    transition:transform .2s ease-out;
  }
  :global(body.route-home) .home-catalog-handoff{background:var(--surface-0)}
  :global(body.route-home) .handoff-links{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    border-top:1px solid var(--border-strong);
  }
  :global(body.route-home) .handoff-links a{
    display:grid;
    grid-template-columns:1fr auto;
    gap:10px;
    min-width:0;
    padding:28px 24px 28px 0;
    border-bottom:1px solid var(--border-soft);
    color:inherit;
    text-decoration:none;
  }
  :global(body.route-home) .handoff-links a + a{
    padding-left:24px;
    border-left:1px solid var(--border-soft);
  }
  :global(body.route-home) .handoff-links span{
    grid-column:1/-1;
    color:var(--t3);
    font-size:13px;
  }
  :global(body.route-home) .handoff-links strong{
    color:var(--t1);
    font-size:20px;
    font-weight:620;
  }
  :global(body.route-home) .handoff-links i{
    color:var(--blue);
    font-style:normal;
    transition:transform .2s ease-out;
  }
  :global(body.route-home) .handoff-links a:hover i,
  :global(body.route-home) .handoff-links a:focus-visible i{transform:translateX(4px)}
  :global(body.route-home) .home-contact{border-bottom:0}
  :global(body.route-home) .contact-list{border-top:1px solid var(--border-strong)}
  :global(body.route-home) .contact-list a{
    display:grid;
    grid-template-columns:130px 1fr auto;
    gap:24px;
    align-items:center;
    padding:24px 0;
    border-bottom:1px solid var(--border-soft);
    color:inherit;
    text-decoration:none;
  }
  :global(body.route-home) .contact-list span{
    color:var(--t3);
    font-family:var(--mono);
    font-size:10px;
    font-weight:700;
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  :global(body.route-home) .contact-list strong{
    min-width:0;
    color:var(--t1);
    font-size:18px;
    font-weight:560;
    overflow-wrap:anywhere;
  }
  :global(body.route-home) .contact-list i{
    color:var(--blue);
    font-style:normal;
    transition:transform .2s ease-out;
  }
  :global(body.route-home) .contact-list a:hover i,
  :global(body.route-home) .contact-list a:focus-visible i{transform:translate(3px,-3px)}
  @media(max-width:860px){
    :global(body.route-home) .home-section-head{grid-template-columns:1fr;gap:24px}
    :global(body.route-home) .home-live-grid{gap:42px 22px}
    :global(body.route-home) .practice-row{grid-template-columns:42px minmax(180px,.65fr) minmax(0,1fr) 20px;gap:18px}
  }
  @media(max-width:640px){
    :global(body.route-home) .minimal-hero{padding:112px 18px 72px}
    :global(body.route-home) .minimal-hero .hero-eyebrow{margin-bottom:26px}
    :global(body.route-home) .minimal-hero .ht{padding:28px 0 0!important}
    :global(body.route-home) .minimal-hero .hero-identity{gap:14px}
    :global(body.route-home) .minimal-hero .hero-avatar{width:50px;height:50px}
    :global(body.route-home) .minimal-hero .hn{font-size:clamp(48px,15vw,64px);letter-spacing:-.062em}
    :global(body.route-home) .minimal-hero .hr{margin-top:28px;font-size:19px}
    :global(body.route-home) .minimal-hero .hero-summary{font-size:15px;line-height:1.65}
    :global(body.route-home) .minimal-hero .ha{display:grid;margin-top:28px}
    :global(body.route-home) .minimal-hero .hero-proof-strip{
      grid-template-columns:1fr;
      margin-top:54px;
    }
    :global(body.route-home) .minimal-hero .hero-proof{
      display:grid;
      grid-template-columns:110px minmax(0,1fr);
      gap:7px 14px;
      width:100%;
      padding:20px 0;
      border-left:0;
      border-top:1px solid var(--border-soft);
    }
    :global(body.route-home) .minimal-hero .hero-proof:first-child{border-top:0}
    :global(body.route-home) .minimal-hero .hero-proof-copy{grid-column:2}
    :global(body.route-home) .home-section{padding:72px 18px}
    :global(body.route-home) .home-section-head{margin-bottom:38px}
