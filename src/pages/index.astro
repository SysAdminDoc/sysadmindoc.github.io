---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LiveCard from '../components/LiveCard.astro';
import GreatestHits from '../components/GreatestHits.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { catalog, liveApps } from '../data/portfolio';
import { contactEmail, contactMailto } from '../data/identity';
import { careerLanes, careerProfile, careerProofExperience } from '../data/career';
// Served from this origin: the GitHub-hosted copy was the site's last
// third-party request and kept a CDN in img-src for one photo.
import avatar from '../assets/avatar.jpg';
import iconForgePreview from '../assets/home-iconforge.jpg';

const livePreview = liveApps.slice(0, 6);
const publicProjectCount = catalog.length;
const heroApp = liveApps.find((app) => app.slug === 'IconForge')!;
const contactPaths = [
  {
    label: 'Email',
    value: contactEmail,
    href: contactMailto(),
    external: false,
  },
  {
    label: 'GitHub',
    value: 'SysAdminDoc',
    href: 'https://github.com/SysAdminDoc',
    external: true,
  },
  {
    label: 'LinkedIn',
    value: 'Matthew Ryan Parker',
    href: 'https://www.linkedin.com/in/matthewryanparker',
    external: true,
  },
] as const;

const cmdkSections = [
  { label: 'Selected Work', href: '#greatest-hits', desc: 'Three representative public projects.', badge: 'START' },
  { label: 'Live Apps', href: '#live', desc: 'A small preview of browser-ready work.', badge: 'LIVE' },
  { label: 'Practice', href: '#skills', desc: 'Infrastructure, healthcare, software, and creative work.', badge: 'SECTION' },
  { label: 'Experience', href: '/healthcare-it/', desc: 'A career across managed IT, public broadcasting, and healthcare.', badge: 'PAGE' },
  { label: 'Project Catalog', href: '/catalog/', desc: 'Browse the complete public project archive.', badge: 'ARCHIVE' },
  { label: 'AI Services', href: '/ai/', desc: 'Implementation, workflow automation, training, and ongoing support.', badge: 'TRACK' },
  { label: 'Resume', href: '/resume/', desc: 'Career history, skills, and experience.', badge: 'PAGE' },
  { label: 'Contact', href: '#connect', desc: 'Email and professional profiles.', badge: 'SECTION' },
] as const;
---
<Base cmdkSections={cmdkSections}>
  <a href="#main" class="skip-link">Skip to content</a>

  <nav id="nav" aria-label="Main navigation">
    <div class="ni">
      <a href="#hero" class="nl" aria-label="SysAdminDoc home">
        <span class="brand-mark" aria-hidden="true">MP</span>
        <span class="brand-copy">
          <strong>SysAdminDoc</strong>
          <small>Systems · Software · Design</small>
        </span>
      </a>
      <div class="nk" id="navLinks">
        <a href="#greatest-hits">Work</a>
        <a href="#skills">Practice</a>
        <a href="/healthcare-it/">Experience</a>
        <a href="/resume/">Resume</a>
        <a href="#connect">Contact</a>
        <div class="nav-indicator" id="navIndicator"></div>
      </div>
      <div class="nav-actions">
        <button type="button" class="theme-toggle" id="themeToggle" aria-label="Switch to light theme" title="Switch to light theme">
          <svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>
        <button type="button" class="nav-search" id="cmdkToggle" aria-label="Open command search" aria-controls="cmdk" aria-expanded="false" aria-haspopup="dialog" title="Open command search">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <button type="button" class="mt" id="mobileToggle" aria-label="Open navigation menu" aria-controls="navLinks" aria-expanded="false" title="Open navigation menu">
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
  </nav>
  <div class="nav-backdrop" id="navBackdrop" aria-hidden="true"></div>
  <div class="scroll-progress" id="scrollProgress"></div>

  <main id="main" data-pagefind-body data-pagefind-filter="Scope:Home">
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="route_type:Home"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="type:Home"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="category:Portfolio"></span>

    <section class="hero minimal-hero" id="hero">
      <div class="hi">
        <div class="ht h-card">
          <p class="hero-eyebrow">Systems. Software. Creative work.</p>
          <div class="hero-identity">
            <h1 class="hn p-name">Matt <span class="a">Parker<span class="hero-period" aria-hidden="true">.</span></span></h1>
            <a class="u-url" href="/" hidden>Matt Parker</a>
          </div>
          <p class="hr">{careerProfile.headline}</p>
          <p class="hero-summary">{careerProfile.operatingNote}</p>
          <div class="ha">
            <a href="#greatest-hits" class="btn bp">See my work <span aria-hidden="true">↓</span></a>
            <a href="/healthcare-it/" class="btn bg2">My experience <span aria-hidden="true">→</span></a>
          </div>
          <div class="hero-location">
            <Image class="hero-avatar loaded u-photo" id="heroAvatar" src={avatar} alt="Matt Parker" width={52} height={52} densities={[1, 2]} loading="eager" decoding="async" />
            <span>Based in Sarasota, FL</span>
          </div>
        </div>

        <div class="hero-showcase">
          <p class="showcase-eyebrow">Built here. Running now.</p>
          <a class="showcase-link" href={heroApp.url} target="_blank" rel="noopener" aria-label="Open IconForge, my browser-based image and icon tool, in a new tab">
            <div class="showcase-window">
              <div class="showcase-toolbar" aria-hidden="true">
                <span class="showcase-window-label">Live app preview</span>
                <span>IconForge</span>
              </div>
              <Picture src={iconForgePreview} alt="IconForge interface with image upload, platform presets, and output options" formats={['avif', 'webp']} widths={[640, 960, 1440]} sizes="(max-width: 640px) calc(100vw - 36px), (max-width: 1080px) 100vw, 55vw" quality={82} loading="eager" decoding="async" fetchpriority="high" />
            </div>
            <div class="showcase-caption">
              <span><strong>IconForge</strong><small>Generate favicons, PWA icons, and extension assets in seconds.</small></span>
              <span class="showcase-action">Open live app <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        </div>

        <div class="hs hero-proof-strip" role="group" aria-label="Experience and portfolio proof">
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl sr-only">{careerProofExperience.label}</span>
            <strong class="hero-proof-value hsn">{careerProofExperience.value}</strong>
            <span class="hero-proof-copy">In IT and healthcare</span>
          </div>
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl sr-only">Shipped</span>
            <strong class="hero-proof-value hsn"><span id="statRepos">{publicProjectCount}</span><sup>+</sup> projects</strong>
            <span class="hero-proof-copy">Public source code</span>
          </div>
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl sr-only">Running now</span>
            <strong class="hero-proof-value hsn"><span id="statLive">{liveApps.length}</span> live apps</strong>
            <span class="hero-proof-copy">Open in your browser</span>
          </div>
        </div>
      </div>
    </section>

    <GreatestHits limit={3} />

    <section id="live" class="home-section home-live" aria-labelledby="live-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">Live apps</span>
            <h2 id="live-title">These are running right now.</h2>
          </div>
          <div class="home-section-intro">
            <p>{liveApps.length} apps you can open in your browser. No signup, no demo call.</p>
            <a href="/screenshots/" class="text-link">View all screenshots <span aria-hidden="true">→</span></a>
          </div>
        </header>
        <div class="home-live-grid">
          {livePreview.map((app) => <LiveCard app={app} />)}
        </div>
      </div>
    </section>

    <section id="skills" class="home-section home-practice" aria-labelledby="practice-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">Practice</span>
            <h2 id="practice-title">What I actually do.</h2>
          </div>
          <p class="home-section-intro">Practical software and hands-on creative work, backed by years in IT operations. Each draws on a different part of my experience.</p>
        </header>
        <div class="practice-list">
          {careerLanes.map((lane, index) => (
            <a href={lane.href} class="practice-row">
              <span class="practice-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="practice-name">
                <strong>{lane.name}</strong>
                <small>{lane.short}</small>
              </span>
              <span class="practice-focus">{lane.focus}</span>
              <span class="practice-action" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="catalog" class="home-section home-catalog-handoff" aria-labelledby="catalog-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">The archive</span>
            <h2 id="catalog-title">Everything I've shipped.</h2>
          </div>
          <p class="home-section-intro">{publicProjectCount} public projects. Search them, filter by stack, or just browse. Every one links to its source code.</p>
        </header>
        <nav class="handoff-links" aria-label="Project discovery">
          <a href="/catalog/"><span>Browse every project</span><strong>Catalog</strong><em>Filter all {publicProjectCount} by stack, freshness, or downloads.</em><i aria-hidden="true">→</i></a>
          <a href="/search/"><span>Find a specific topic</span><strong>Search</strong><em>Full-text search across every README and write-up.</em><i aria-hidden="true">→</i></a>
          <a href="/releases/"><span>See what shipped</span><strong>Releases</strong><em>Every tagged release, newest first, with its notes.</em><i aria-hidden="true">→</i></a>
        </nav>
      </div>
    </section>

    <section id="connect" class="home-section home-contact" aria-labelledby="contact-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">Contact</span>
            <h2 id="contact-title">Want to work together?</h2>
          </div>
          <p class="home-section-intro">Tell me what you're dealing with. If I can help, I'll say so. If I can't, I'll say that too.</p>
        </header>
        <div class="contact-grid">
          <div class="contact-card">
            <ContactForm />
          </div>
          <aside class="contact-aside" aria-labelledby="contact-direct-title">
            <h3 id="contact-direct-title">Or reach me directly</h3>
            <div class="contact-list">
              {contactPaths.map((path) => (
                <a href={path.href} target={path.external ? '_blank' : undefined} rel={path.external ? 'noopener' : undefined}>
                  <span>{path.label}</span>
                  <strong>{path.value}</strong>
                  <i aria-hidden="true">↗</i>
                </a>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Footer
    variant="home"
    summary="I build things, write them up, and keep them running. Thanks for taking a look."
    links={[
      { href: '/catalog/', label: 'Projects' },
      { href: '/ai/', label: 'AI services' },
      { href: '/resume/', label: 'Resume' },
      { href: 'https://github.com/SysAdminDoc', label: 'GitHub', external: true },
    ]}
  />
</Base>

<style>
  /* Editorial homepage. Real app imagery sits beside the profile. */
  :global(body.route-home){--content-max:1276px}
  :global(body.route-home) #nav .ni{width:min(var(--content-max),calc(100% - 64px));max-width:none;padding-inline:0}
  :global(body.route-home) .minimal-hero{
    position:relative;
    min-height:0;
    padding:calc(var(--nav-h,70px) + 42px) 32px 0;
    border-bottom:0;
    background:transparent;
    overflow:hidden;
    isolation:isolate;
  }
  :global(body.route-home) .minimal-hero::after{display:none}
  :global(body.route-home) .minimal-hero .hi{
    display:grid;
    grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);
    gap:30px 72px;
    align-items:center;
    width:min(var(--content-max),100%);
    max-width:none;
    min-height:0;
    margin:0 auto;
    padding:0;
    border:0;
  }
  :global(body.route-home) .minimal-hero .ht{
    display:block!important;
    grid-column:1;
    grid-row:1;
    max-width:none;
    padding:0!important;
    border:0!important;
  }
  :global(body.route-home) .minimal-hero .hero-eyebrow,
  .showcase-eyebrow{
    display:block;
    margin:0 0 22px;
    padding:0;
    border:0;
    background:none;
    color:var(--blue);
    font-family:var(--sans);
    font-size:11px;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
  }
  :global(body.route-home) .minimal-hero .hero-identity{display:block;margin:0}
  :global(body.route-home) .minimal-hero .hn{
    max-width:none;
    margin:0;
    color:var(--t1);
    font-size:clamp(86px,9.75vw,140px);
    font-weight:700;
    line-height:.78;
    letter-spacing:-.035em;
    text-wrap:initial;
  }
  :global(body.route-home) .minimal-hero .hn .a{display:block;color:var(--blue)}
  .hero-period{color:var(--t1)}
  :global(body.route-home) .minimal-hero .hr{
    max-width:21ch;
    margin:26px 0 0;
    color:var(--t1);
    font-family:var(--sans);
    font-size:clamp(24px,2.25vw,32px);
    font-weight:600;
    line-height:1.2;
    letter-spacing:-.02em;
    text-wrap:pretty;
  }
  :global(body.route-home) .minimal-hero .hero-summary{
    max-width:49ch;
    margin:18px 0 0;
    color:var(--t2);
    font-size:17px;
    line-height:1.55;
  }
  :global(body.route-home) .minimal-hero .ha{display:flex;flex-wrap:wrap;gap:14px;margin-top:24px}
  :global(body.route-home) .minimal-hero .ha .btn{min-width:190px;min-height:50px;padding:12px 28px;border-radius:6px;font-size:15px}
  .hero-location{display:flex;align-items:center;gap:16px;margin-top:26px;color:var(--t2);font-size:13px}
  :global(body.route-home) .minimal-hero .hero-avatar{order:0;flex:0 0 auto;width:44px;height:44px;margin:0;border:1px solid var(--border-soft);border-radius:12px;box-shadow:none;object-fit:cover;filter:none}
  .hero-showcase{min-width:0;grid-column:2;grid-row:1;align-self:center}
  .showcase-eyebrow{margin-bottom:16px}
  .showcase-link{display:block;color:inherit;text-decoration:none}
  .showcase-window{overflow:hidden;border:1px solid var(--border-hover);border-radius:10px;background:var(--surface-1);box-shadow:var(--edge),var(--shadow-lg);transition:border-color var(--dur-base) var(--ease-out),transform var(--dur-base) var(--ease-out)}
  .showcase-toolbar{display:flex;justify-content:space-between;align-items:center;height:34px;padding:0 16px;border-bottom:1px solid var(--border-soft);background:var(--surface-2);color:var(--t3);font-size:10px}
  .showcase-window-label{font-weight:600;letter-spacing:.06em;text-transform:uppercase}
  .showcase-window :global(picture){display:block;aspect-ratio:1.5;overflow:hidden}
  .showcase-window :global(img){display:block;width:100%;height:100%;object-fit:cover;object-position:top left}
  .showcase-caption{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-top:14px}
  .showcase-caption strong{display:block;font-size:16px;font-weight:650}
  .showcase-caption small{display:block;max-width:45ch;margin-top:5px;color:var(--t2);font-size:12px;line-height:1.55}
  .showcase-action{flex-shrink:0;color:var(--blue);font-size:12px;font-weight:600}
  .showcase-link:hover .showcase-window{border-color:var(--blue);transform:translateY(-3px)}
  .showcase-link:focus-visible{outline:2px solid var(--focus-outline);outline-offset:6px;border-radius:10px}
  :global(body.route-home) .minimal-hero .hero-proof-strip{
    position:relative;
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    grid-column:1/-1;
    grid-row:2;
    width:100%;
    max-width:none;
    margin:0;
    padding:28px 0;
    border:0;
    border-block:1px solid var(--border-soft);
    border-radius:0;
    background:transparent;
    box-shadow:none;
  }
  :global(body.route-home) .minimal-hero .hero-proof{
    display:flex;
    min-width:0;
    min-height:0;
    padding:0 24px;
    flex-direction:column;
    align-items:center;
    gap:7px;
    border:0;
    border-left:1px solid var(--border-soft);
    border-radius:0;
    background:transparent;
    box-shadow:none;
    text-align:center;
  }
  :global(body.route-home) .minimal-hero .hero-proof:first-child{border-left:0}
  :global(body.route-home) .minimal-hero .hero-proof-value{color:var(--t1);font-family:var(--sans);font-size:34px;font-weight:700;line-height:1.1;letter-spacing:-.02em}
  :global(body.route-home) .minimal-hero .hero-proof-value sup{position:static;color:var(--t1);font-size:1em;vertical-align:baseline}
  :global(body.route-home) .minimal-hero .hero-proof-copy{align-self:auto;max-width:none;color:var(--t2);font-size:15px;line-height:1.5;text-align:inherit}
  @media(max-width:1080px){
    :global(body.route-home) .minimal-hero .hi{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:30px 36px}
    :global(body.route-home) .minimal-hero .hn{font-size:clamp(80px,10vw,110px)}
    :global(body.route-home) .minimal-hero .hr{font-size:27px}
    .showcase-caption{align-items:start;flex-direction:column;gap:8px}
  }
  @media(max-width:800px){
    :global(body.route-home) .minimal-hero .hi{grid-template-columns:1fr;gap:36px}
    .hero-showcase{grid-column:1;grid-row:2}
    :global(body.route-home) .minimal-hero .hero-proof-strip{grid-row:3}
    .showcase-window :global(picture){aspect-ratio:1.6}
    .showcase-caption{flex-direction:row;align-items:end}
  }
  @media(max-width:640px){
    :global(body.route-home) #nav .ni{width:calc(100% - 36px)}
    :global(body.route-home) .minimal-hero{padding:calc(var(--nav-h,70px) + 40px) 18px 0}
    :global(body.route-home) .minimal-hero .hero-eyebrow{font-size:10px;letter-spacing:.12em;margin-bottom:24px}
    :global(body.route-home) .minimal-hero .hn{font-size:clamp(78px,21vw,112px);line-height:.9}
    :global(body.route-home) .minimal-hero .hr{margin-top:24px;font-size:26px;max-width:24ch}
    :global(body.route-home) .minimal-hero .hero-summary{font-size:16px;line-height:1.6}
    :global(body.route-home) .minimal-hero .ha{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    :global(body.route-home) .minimal-hero .ha .btn{min-width:0;justify-content:center;padding:12px 14px;font-size:14px}
    .hero-location{margin-top:22px}
    .hero-showcase{margin-top:4px}
    .showcase-caption{gap:12px}
    .showcase-caption small{max-width:29ch;font-size:11px}
    .showcase-action{font-size:11px}
    :global(body.route-home) .minimal-hero .hero-proof-strip{padding:22px 0}
    :global(body.route-home) .minimal-hero .hero-proof{padding:0 8px;gap:7px}
    :global(body.route-home) .minimal-hero .hero-proof-value{font-size:clamp(17px,4.5vw,24px);white-space:nowrap}
    :global(body.route-home) .minimal-hero .hero-proof-copy{font-size:11px;line-height:1.4;max-width:13ch}
  }
  @media(prefers-reduced-motion:reduce){.showcase-link:hover .showcase-window{transform:none}}

  /* Sections: shared head, alternating bands, cards instead of hairline rows. */
  :global(body.route-home) .home-section{
    padding:clamp(80px,9vw,128px) 32px;
    border:0;
    background:transparent;
  }
  :global(body.route-home) .home-live,
  :global(body.route-home) .home-catalog-handoff{
    border-block:1px solid var(--border-soft);
    background:var(--grain) repeat,var(--bg2);
  }
  :global(body.route-home) .home-shell{
    width:min(var(--content-max,1240px),100%);
    margin:0 auto;
  }
  :global(body.route-home) .home-section-head{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(280px,440px);
    gap:24px 48px;
    align-items:end;
    margin-bottom:48px;
  }
  :global(body.route-home) .home-section-index{
    display:block;
    margin-bottom:18px;
    color:var(--blue);
    font-family:var(--sans);
    font-size:12px;
    font-weight:600;
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  :global(body.route-home) .home-section h2{
    max-width:18ch;
    margin:0;
    color:var(--t1);
    font-size:clamp(34px,3.8vw,52px);
    font-weight:650;
    line-height:1.06;
    letter-spacing:-.022em;
  }
  :global(body.route-home) .home-section-intro{
    max-width:46ch;
    margin:0;
    color:var(--t2);
    font-size:17px;
    line-height:1.7;
  }
  :global(body.route-home) .home-section-intro p{margin:0 0 12px}
  :global(body.route-home) .text-link{
    display:inline-flex;
    min-height:44px;
    align-items:center;
    gap:8px;
    color:var(--blue);
    font-family:var(--sans);
    font-size:15px;
    font-weight:600;
    text-decoration:none;
  }
  :global(body.route-home) .text-link span{transition:transform var(--dur-fast,.18s) var(--ease-out,ease-out)}
  :global(body.route-home) .text-link:hover span,
  :global(body.route-home) .text-link:focus-visible span{transform:translateX(3px)}

  /* Live apps: three per row, the screenshot framed as a window. */
  :global(body.route-home) .home-live-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:24px;
  }
  :global(body.route-home) .home-live-grid :global(.lc2){
    display:flex;
    min-width:0;
    flex-direction:column;
