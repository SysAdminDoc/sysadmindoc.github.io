---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LiveCard from '../components/LiveCard.astro';
import GreatestHits from '../components/GreatestHits.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { catalog, liveApps } from '../data/portfolio';
import { contactEmail, contactMailto } from '../data/identity';
import { careerLanes, careerProfile, careerProofExperience } from '../data/career';
// Served from this origin: the GitHub-hosted copy was the site's last
// third-party request and kept a CDN in img-src for one photo.
import avatar from '../assets/avatar.jpg';

const livePreview = liveApps.slice(0, 6);
const publicProjectCount = catalog.length;
const contactPaths = [
  {
    label: 'Email',
    value: contactEmail,
    href: contactMailto(),
    external: false,
  },
  {
    label: 'GitHub',
    value: 'SysAdminDoc',
    href: 'https://github.com/SysAdminDoc',
    external: true,
  },
  {
    label: 'LinkedIn',
    value: 'Matthew Ryan Parker',
    href: 'https://www.linkedin.com/in/matthewryanparker',
    external: true,
  },
] as const;

const cmdkSections = [
  { label: 'Selected Work', href: '#greatest-hits', desc: 'Three representative public projects.', badge: 'START' },
  { label: 'Live Apps', href: '#live', desc: 'A small preview of browser-ready work.', badge: 'LIVE' },
  { label: 'Practice', href: '#skills', desc: 'AI implementation, healthcare systems, and infrastructure.', badge: 'SECTION' },
  { label: 'Project Catalog', href: '/catalog/', desc: 'Browse the complete public project archive.', badge: 'ARCHIVE' },
  { label: 'AI Services', href: '/ai/', desc: 'Implementation, workflow automation, training, and ongoing support.', badge: 'TRACK' },
  { label: 'Resume', href: '/resume/', desc: 'Career history, skills, and experience.', badge: 'PAGE' },
  { label: 'Contact', href: '#connect', desc: 'Email and professional profiles.', badge: 'SECTION' },
] as const;
---
<Base cmdkSections={cmdkSections}>
  <a href="#main" class="skip-link">Skip to content</a>

  <nav id="nav" aria-label="Main navigation">
    <div class="ni">
      <a href="#hero" class="nl" aria-label="SysAdminDoc home">
        <span class="brand-mark" aria-hidden="true">MP</span>
        <span class="brand-copy">
          <strong>SysAdminDoc</strong>
          <small>AI · Healthcare · Systems</small>
        </span>
      </a>
      <div class="nk" id="navLinks">
        <a href="#greatest-hits">Work</a>
        <a href="#skills">Practice</a>
        <a href="/ai/">AI</a>
        <a href="/resume/">Resume</a>
        <a href="#connect">Contact</a>
        <div class="nav-indicator" id="navIndicator"></div>
      </div>
      <div class="nav-actions">
        <button type="button" class="theme-toggle" id="themeToggle" aria-label="Switch to light theme" title="Switch to light theme">
          <svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>
        <button type="button" class="nav-search" id="cmdkToggle" aria-label="Open command search" aria-controls="cmdk" aria-expanded="false" aria-haspopup="dialog" title="Open command search">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <button type="button" class="mt" id="mobileToggle" aria-label="Open navigation menu" aria-controls="navLinks" aria-expanded="false" title="Open navigation menu">
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
  </nav>
  <div class="nav-backdrop" id="navBackdrop" aria-hidden="true"></div>
  <div class="scroll-progress" id="scrollProgress"></div>

  <main id="main" data-pagefind-body data-pagefind-filter="Scope:Home">
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="route_type:Home"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="type:Home"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="category:Portfolio"></span>

    <section class="hero minimal-hero" id="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hi">
        <div class="ht">
          <p class="hero-eyebrow">Sarasota, FL</p>
          <div class="hero-identity h-card">
            <Image class="hero-avatar loaded u-photo" id="heroAvatar" src={avatar} alt="Matt Parker" width={82} height={82} densities={[1, 2]} loading="eager" decoding="async" fetchpriority="high" />
            <h1 class="hn p-name">Matt <span class="a">Parker</span></h1>
            <a class="u-url" href="/" hidden>Matt Parker</a>
          </div>
          <p class="hr">{careerProfile.headline}</p>
          <p class="hero-summary">{careerProfile.operatingNote}</p>
          <div class="ha">
            <a href="#greatest-hits" class="btn bp">See my work <span aria-hidden="true">↓</span></a>
            <a href="/ai/" class="btn bg2">AI services <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="hs hero-proof-strip" role="group" aria-label="Experience and portfolio proof">
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl">{careerProofExperience.label}</span>
            <strong class="hero-proof-value hsn">{careerProofExperience.value}</strong>
            <span class="hero-proof-copy">{careerProofExperience.detail}</span>
          </div>
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl">Shipped</span>
            <strong class="hero-proof-value hsn"><span id="statRepos">{publicProjectCount}</span><sup>+</sup> projects</strong>
            <span class="hero-proof-copy">All public, all on GitHub</span>
          </div>
          <div class="hs-item hero-proof">
            <span class="hero-proof-label hsl">Running now</span>
            <strong class="hero-proof-value hsn"><span id="statLive">{liveApps.length}</span> live apps</strong>
            <span class="hero-proof-copy">Open them and see</span>
          </div>
        </div>
      </div>
    </section>

    <GreatestHits limit={3} />

    <section id="live" class="home-section home-live" aria-labelledby="live-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">02 / Live</span>
            <h2 id="live-title">These are running right now.</h2>
          </div>
          <div class="home-section-intro">
            <p>{liveApps.length} apps you can open in your browser. No signup, no demo call.</p>
            <a href="/screenshots/" class="text-link">View all screenshots <span aria-hidden="true">→</span></a>
          </div>
        </header>
        <div class="home-live-grid">
          {livePreview.map((app) => <LiveCard app={app} />)}
        </div>
      </div>
    </section>

    <section id="skills" class="home-section home-practice" aria-labelledby="practice-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">03 / Practice</span>
            <h2 id="practice-title">What I actually do.</h2>
          </div>
          <p class="home-section-intro">Three areas, one person. I go deep in each of these instead of spreading thin across everything.</p>
        </header>
        <div class="practice-list">
          {careerLanes.map((lane, index) => (
            <a href={lane.href} class="practice-row">
              <span class="practice-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="practice-name">
                <strong>{lane.name}</strong>
                <small>{lane.short}</small>
              </span>
              <span class="practice-focus">{lane.focus}</span>
              <span class="practice-action" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="catalog" class="home-section home-catalog-handoff" aria-labelledby="catalog-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">04 / Explore</span>
            <h2 id="catalog-title">Everything I've shipped.</h2>
          </div>
          <p class="home-section-intro">{publicProjectCount} public projects. Search them, filter by stack, or just browse. Every one links to its source code.</p>
        </header>
        <nav class="handoff-links" aria-label="Project discovery">
          <a href="/catalog/"><span>Browse every project</span><strong>Catalog</strong><em>Filter all {publicProjectCount} by stack, freshness, or downloads.</em><i aria-hidden="true">→</i></a>
          <a href="/search/"><span>Find a specific topic</span><strong>Search</strong><em>Full-text search across every README and write-up.</em><i aria-hidden="true">→</i></a>
          <a href="/releases/"><span>See what shipped</span><strong>Releases</strong><em>Every tagged release, newest first, with its notes.</em><i aria-hidden="true">→</i></a>
        </nav>
      </div>
    </section>

    <section id="connect" class="home-section home-contact" aria-labelledby="contact-title">
      <div class="home-shell">
        <header class="home-section-head rv">
          <div>
            <span class="home-section-index">05 / Contact</span>
            <h2 id="contact-title">Want to work together?</h2>
          </div>
          <p class="home-section-intro">Tell me what you're dealing with. If I can help, I'll say so. If I can't, I'll say that too.</p>
        </header>
        <div class="contact-grid">
          <div class="contact-card">
            <ContactForm />
          </div>
          <aside class="contact-aside" aria-labelledby="contact-direct-title">
            <h3 id="contact-direct-title">Or reach me directly</h3>
            <div class="contact-list">
              {contactPaths.map((path) => (
                <a href={path.href} target={path.external ? '_blank' : undefined} rel={path.external ? 'noopener' : undefined}>
                  <span>{path.label}</span>
                  <strong>{path.value}</strong>
                  <i aria-hidden="true">↗</i>
                </a>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Footer
    variant="home"
    summary="I build things, write them up, and keep them running. Thanks for taking a look."
    links={[
      { href: '/catalog/', label: 'Projects' },
      { href: '/ai/', label: 'AI services' },
      { href: '/resume/', label: 'Resume' },
      { href: 'https://github.com/SysAdminDoc', label: 'GitHub', external: true },
    ]}
  />
</Base>

<style>
  /* Hero: name and pitch on the left, a proof card on the right, over a faint
     engineering grid that fades out toward the edges. */
  :global(body.route-home) .minimal-hero{
    position:relative;
    min-height:0;
    padding:calc(var(--nav-h,70px) + clamp(48px,7vw,104px)) 32px clamp(48px,5vw,72px);
    border-bottom:0;
    background:transparent;
    overflow:hidden;
    isolation:isolate;
  }
  :global(body.route-home) .minimal-hero .hero-grid{
    position:absolute;
    inset:0;
    z-index:-1;
    pointer-events:none;
    background-image:linear-gradient(var(--hero-grid) 1px,transparent 1px),linear-gradient(90deg,var(--hero-grid) 1px,transparent 1px);
    background-size:56px 56px;
    background-position:center top;
    mask-image:radial-gradient(ellipse 72% 70% at 62% 28%,#000 25%,transparent 78%);
  }
  :global(body.route-home) .minimal-hero::after{display:none}
  :global(body.route-home) .minimal-hero .hi{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(320px,380px);
    gap:48px clamp(40px,5vw,80px);
    align-items:center;
    width:min(var(--content-max,1240px),100%);
    max-width:none;
    min-height:0;
    margin:0 auto;
    padding:0;
    border:0;
  }
  :global(body.route-home) .minimal-hero .ht{
    display:block!important;
    grid-column:1;
    grid-row:1;
    max-width:760px;
    padding:0!important;
    border:0!important;
  }
  :global(body.route-home) .minimal-hero .hero-eyebrow{
    display:flex;
    width:max-content;
    align-items:center;
    gap:9px;
    margin:0 0 32px;
    padding:6px 12px 6px 10px;
    border:1px solid var(--border-soft);
    border-radius:6px;
    background:var(--surface-1);
    color:var(--t2);
    font-family:var(--mono);
    font-size:12px;
    font-weight:500;
    letter-spacing:.06em;
    text-transform:uppercase;
  }
  :global(body.route-home) .minimal-hero .hero-eyebrow::before{
    content:'';
    width:7px;
    height:7px;
    border-radius:0;
    background:var(--grn);
    box-shadow:0 0 0 3px color-mix(in srgb,var(--grn) 22%,transparent);
  }
  :global(body.route-home) .minimal-hero .hero-identity{
    display:flex;
    align-items:center;
    gap:24px;
  }
  :global(body.route-home) .minimal-hero .hero-avatar{
    flex:0 0 auto;
    width:76px;
    height:76px;
    border:1px solid var(--border-soft);
    border-radius:12px;
    box-shadow:0 0 0 4px var(--accent-soft);
    object-fit:cover;
  }
  :global(body.route-home) .minimal-hero .hn{
    max-width:none;
    margin:0;
    color:var(--t1);
    font-size:clamp(54px,7vw,96px);
    font-weight:700;
    line-height:.98;
    letter-spacing:-.025em;
  }
  :global(body.route-home) .minimal-hero .hn .a{color:var(--t1)}
  :global(body.route-home) .minimal-hero .hr{
    max-width:30ch;
    margin:32px 0 0;
    color:var(--t1);
    font-family:var(--sans);
    font-size:clamp(20px,1.9vw,26px);
    font-weight:500;
    line-height:1.35;
    letter-spacing:-.015em;
  }
  :global(body.route-home) .minimal-hero .hero-summary{
    max-width:58ch;
    margin:16px 0 0;
    color:var(--t2);
    font-size:17px;
    line-height:1.7;
  }
  :global(body.route-home) .minimal-hero .ha{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:36px;
  }
  :global(body.route-home) .minimal-hero .hero-proof-strip{
    position:relative;
    display:grid;
    grid-template-columns:1fr;
    grid-column:2;
    grid-row:1;
    align-self:center;
    width:100%;
    margin:0;
    padding:6px 28px;
    border:1px solid var(--border-soft);
    border-radius:12px;
    background:linear-gradient(180deg,var(--surface-2),var(--surface-1) 60%);
    box-shadow:var(--shadow-md);
  }
  :global(body.route-home) .minimal-hero .hero-proof-strip::before{
    content:'';
    position:absolute;
    top:-1px;
    left:24px;
    right:24px;
    height:1px;
    background:linear-gradient(90deg,transparent,var(--blue),transparent);
  }
  :global(body.route-home) .minimal-hero .hero-proof{
    display:flex;
    min-width:0;
    min-height:0;
    padding:22px 0;
    flex-direction:column;
    align-items:flex-start;
    gap:6px;
    border:0;
    border-top:1px solid var(--border-soft);
    border-radius:0;
    background:transparent;
    box-shadow:none;
  }
  :global(body.route-home) .minimal-hero .hero-proof:first-child{border-top:0}
  :global(body.route-home) .minimal-hero .hero-proof-label{
    color:var(--t3);
    font-family:var(--mono);
    font-size:11px;
    font-weight:600;
    letter-spacing:.1em;
    text-transform:uppercase;
  }
  :global(body.route-home) .minimal-hero .hero-proof-value{
    color:var(--t1);
    font-family:var(--sans);
    font-size:30px;
    font-weight:650;
    line-height:1.1;
    letter-spacing:-.02em;
  }
  :global(body.route-home) .minimal-hero .hero-proof-value sup{
    position:static;
    color:var(--blue);
    font-size:.6em;
    vertical-align:super;
  }
  :global(body.route-home) .minimal-hero .hero-proof-copy{
    color:var(--t3);
    font-size:14px;
    line-height:1.5;
  }

  /* Sections: shared head, alternating bands, cards instead of hairline rows. */
  :global(body.route-home) .home-section{
    padding:clamp(80px,9vw,128px) 32px;
    border:0;
    background:transparent;
  }
  :global(body.route-home) .home-live,
  :global(body.route-home) .home-catalog-handoff{
    border-block:1px solid var(--border-soft);
    background:var(--bg2);
  }
  :global(body.route-home) .home-shell{
    width:min(var(--content-max,1240px),100%);
    margin:0 auto;
  }
  :global(body.route-home) .home-section-head{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(280px,440px);
    gap:24px 48px;
    align-items:end;
    margin-bottom:48px;
  }
  :global(body.route-home) .home-section-index{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:16px;
    color:var(--blue);
    font-family:var(--mono);
    font-size:12px;
    font-weight:600;
    letter-spacing:.1em;
    text-transform:uppercase;
  }
  :global(body.route-home) .home-section-index::before{
    content:'';
    width:24px;
    height:1px;
    background:currentColor;
  }
  :global(body.route-home) .home-section h2{
    max-width:18ch;
    margin:0;
    color:var(--t1);
    font-size:clamp(34px,3.8vw,52px);
    font-weight:650;
    line-height:1.06;
    letter-spacing:-.03em;
  }
  :global(body.route-home) .home-section-intro{
    max-width:46ch;
    margin:0;
    color:var(--t2);
    font-size:17px;
    line-height:1.7;
  }
  :global(body.route-home) .home-section-intro p{margin:0 0 12px}
  :global(body.route-home) .text-link{
    display:inline-flex;
    min-height:44px;
    align-items:center;
    gap:8px;
    color:var(--blue);
    font-family:var(--sans);
    font-size:15px;
    font-weight:600;
    text-decoration:none;
  }
  :global(body.route-home) .text-link span{transition:transform var(--dur-fast,.18s) var(--ease-out,ease-out)}
  :global(body.route-home) .text-link:hover span,
  :global(body.route-home) .text-link:focus-visible span{transform:translateX(3px)}

  /* Live apps: three per row, the screenshot framed as a window. */
  :global(body.route-home) .home-live-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:24px;
  }
  :global(body.route-home) .home-live-grid :global(.lc2){
    display:flex;
    min-width:0;
    flex-direction:column;
    gap:0;
    padding:0;
    overflow:hidden;
    /* The outline is a ring, not a border, so the thumbnail spans the card's full width. */
    border:0;
    border-radius:12px;
    background:var(--surface-1);
    box-shadow:0 0 0 1px var(--border-soft),var(--shadow-sm);
    transform:none;
    transition:opacity .5s var(--ease-out,ease-out),transform var(--dur-base,.25s) var(--ease-out,ease-out),box-shadow var(--dur-base,.25s) var(--ease-out,ease-out);
  }
  :global(body.route-home) .home-live-grid :global(.lc2::before),
  :global(body.route-home) .home-live-grid :global(.lc2::after){display:none}
  :global(body.route-home) .home-live-grid :global(.lc2:hover),
  :global(body.route-home) .home-live-grid :global(.lc2:focus-visible){
    box-shadow:0 0 0 1px var(--border-strong),var(--shadow-lg);
    transform:translateY(-4px);
  }
  :global(body.route-home) .home-live-grid :global(.lc2:focus-visible){outline:2px solid var(--focus-outline);outline-offset:3px}
  :global(body.route-home) .home-live-grid :global(.lc2-thumb){
    aspect-ratio:16/10;
    margin:0;
    overflow:hidden;
    border:0;
    border-bottom:1px solid var(--border-soft);
    border-radius:0;
    background:var(--bg3);
    box-shadow:none;
  }
  :global(body.route-home) .home-live-grid :global(.lc2-thumb img){
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:top center;
    transition:transform .6s var(--ease-out,ease-out);
  }
  :global(body.route-home) .home-live-grid :global(.lc2:hover .lc2-thumb img){transform:scale(1.03)}
  :global(body.route-home) .home-live-grid :global(.lct){
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin:0;
    padding:20px 20px 0;
  }
  :global(body.route-home) .home-live-grid :global(.lcn){
    min-width:0;
    color:var(--t1);
    font-family:var(--sans);
    font-size:18px;
    font-weight:650;
    letter-spacing:-.01em;
    overflow-wrap:anywhere;
  }
  :global(body.route-home) .home-live-grid :global(.lb2){
    display:inline-flex;
    flex:0 0 auto;
    align-items:center;
    gap:6px;
    padding:3px 8px;
    border:0;
    border-radius:6px;
    background:color-mix(in srgb,var(--grn) 14%,transparent);
    /* Pulled toward the ink so the label clears 4.5:1 on its own tint in both themes. */
    color:color-mix(in srgb,var(--grn) 76%,var(--t1));
    font-family:var(--sans);
    font-size:12px;
    font-weight:600;
    letter-spacing:0;
    text-transform:none;
  }
  :global(body.route-home) .home-live-grid :global(.lb2::before){
    content:'';
    width:6px;
    height:6px;
    border-radius:0;
    background:currentColor;
  }
  :global(body.route-home) .home-live-grid :global(.lcd){
    flex:1;
    padding:8px 20px 0;
    color:var(--t2);
    font-size:15px;
    line-height:1.6;
  }
  :global(body.route-home) .home-live-grid :global(.lc2-foot){
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-top:20px;
    padding:14px 20px;
    border-top:1px solid var(--border-soft);
  }
  :global(body.route-home) .home-live-grid :global(.lc2-origin){
    min-width:0;
    overflow:hidden;
    color:var(--t3);
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:0;
    text-overflow:ellipsis;
    text-transform:none;
    white-space:nowrap;
  }
  :global(body.route-home) .home-live-grid :global(.lc2-cta){
    flex:0 0 auto;
    color:var(--blue);
    font-family:var(--sans);
    font-size:13px;
    font-weight:600;
