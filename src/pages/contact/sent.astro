---
// Where the contact handler sends a visitor whose browser posted the form
// without JavaScript (a 303 after the message is stored). Kept out of search
// engines, the sitemap and the search index: it only means something right
// after a submission.
import Base from '../../layouts/Base.astro';
import InteriorNav from '../../components/InteriorNav.astro';
import Footer from '../../components/Footer.astro';
import { contactEmail, contactMailto } from '../../data/identity';
---
<Base title="Message received | Matt Parker" description="Your message reached Matt Parker, who will reply by email." noindex>
  <a href="#main" class="skip-link">Skip to content</a>
  <InteriorNav contextLabel="Contact" contextTone="green" />

  <main id="main" class="error-page">
    <div class="si page-shell">
      <div class="sh rv">
        <div class="sl">// Message received</div>
        <h1 class="st">Thanks, your message is in</h1>
        <p class="sd">
          It's saved, and I'll reply to the email address you gave. If it can't wait, email me at
          <a href={contactMailto()}>{contactEmail}</a>.
        </p>
      </div>

      <div class="error-recovery rv">
        <a href="/" class="btn bp">Back to homepage</a>
        <a href="/catalog/" class="btn bg2">Browse the catalog</a>
      </div>
    </div>
  </main>

  <Footer
    summary="Thanks for getting in touch."
    links={[
      { href: '/catalog/', label: 'Catalog' },
      { href: '/resume/', label: 'Resume' },
      { href: 'https://github.com/SysAdminDoc', label: 'GitHub', external: true },
    ]}
  />
</Base>
