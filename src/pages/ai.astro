---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import InteriorNav from '../components/InteriorNav.astro';
import SectionJumpNav from '../components/SectionJumpNav.astro';
import Footer from '../components/Footer.astro';
import { interiorOgPageBySlug } from '../data/interior-og-pages';
import {
  formatReviewedDate,
  pageFreshnessBySlug,
  reviewedWebPageJsonLd,
  serviceCatalogNodes,
} from '../data/page-freshness';
import { catalog, liveApps } from '../data/portfolio';
import { contactEmail, contactMailto, experienceLabel, experienceShort } from '../data/identity';

const title = 'AI Services — Matt Parker';
const pageOg = interiorOgPageBySlug['ai'];
const pageFreshness = pageFreshnessBySlug['ai'];
const reviewedLabel = formatReviewedDate(pageFreshness.lastReviewed);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://sysadmindoc.github.io';
const projectCount = catalog.length;
const liveAppCount = liveApps.length;

const services = [
  {
    tag: 'Adoption',
    name: 'AI rollout & tooling',
    question: 'How do we choose and roll out the right AI tools?',
    desc: 'I evaluate your workflows, select the right fit — Claude, ChatGPT, Copilot, or local models when data must stay in-house — then configure, secure, and drive adoption of it. You get a working rollout, not another shelfware license.',
  },
  {
    tag: 'Automation',
    name: 'Custom software & automation',
    question: 'What can AI automate in our existing workflow?',
    desc: 'I build purpose-built tools for the gaps between your systems: report generation, document processing, data entry, monitoring, and integrations. Useful scope ships in days or weeks, not quarters.',
  },
  {
    tag: 'Training',
    name: 'Employee enablement',
    question: 'How do we train employees to use AI safely?',
    desc: 'I train your team on its real daily work, with prompt patterns that hold up in practice and clear guardrails for what not to automate. People leave with playbooks they will keep using.',
  },
  {
    tag: 'Retainer',
    name: 'Standing problem-solving',
    question: 'Who handles new automation problems after launch?',
    desc: 'I stay on call for whatever comes up: a slow process, a manual report, or two systems that will not talk to each other. You describe the friction; it comes back solved, documented, and maintained.',
  },
] as const;

// Publish the offer list as structured data from the same array that renders the
// cards below, so an answer engine reads exactly what a visitor reads.
const pageJsonLd = reviewedWebPageJsonLd({
  siteUrl,
  route: pageFreshness.route,
  title,
  description: pageOg.description,
  lastReviewed: pageFreshness.lastReviewed,
  schemaTypes: pageFreshness.schemaTypes,
  extraNodes: serviceCatalogNodes({
    siteUrl,
    route: pageFreshness.route,
    catalogName: 'AI implementation services',
    services,
  }),
});

const engagementSteps = [
  {
    step: '01',
    name: 'Discovery',
    question: 'Where is your business losing time?',
    desc: 'We start with a free conversation about the work that drags. I will tell you plainly what AI can fix, what it cannot, and what a useful first step would take.',
  },
  {
    step: '02',
    name: 'Pilot',
    question: 'Can we prove value before a larger commitment?',
    desc: 'Yes — the pilot solves one measurable problem with fixed scope and a fast turnaround. You see a working result before committing to anything ongoing.',
  },
  {
    step: '03',
    name: 'Retainer',
    question: 'What happens after the pilot works?',
    desc: 'A flat monthly retainer covers implementation, training, and new problems as they surface. There is no long contract, and you keep everything I build.',
  },
] as const;

const cmdkSections = [
  { label: 'Where AI Helps', href: '#track-overview', desc: 'How AI can remove real work from a small or mid-size business.', badge: 'TRACK' },
  { label: 'Services', href: '#services', desc: 'Answers about rollout, automation, training, and ongoing support.', badge: 'SERVICES' },
  { label: 'Engagement', href: '#engagement', desc: 'Answers about discovery, a pilot, and ongoing delivery.', badge: 'PROCESS' },
  { label: 'Evidence', href: '#proof', desc: 'What this public portfolio proves about the working model.', badge: 'CONTEXT' },
  { label: 'Start', href: '#ai-contact', desc: 'What to send to begin a useful conversation.', badge: 'CONTACT' },
] as const;
---
<Base
  title={title}
  description={pageOg.description}
  ogImage={pageOg.ogImage}
  ogImageAlt={pageOg.ogImageAlt}
  cmdkSections={cmdkSections}
>
  <script is:inline type="application/ld+json" set:html={pageJsonLd} />
  <a href="#main" class="skip-link">Skip to content</a>
  <InteriorNav active="ai" contextLabel="AI services track" contextTone="purple" />

  <main id="main" class="aisvc-page" data-pagefind-body data-pagefind-filter="Scope:AI Services">
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="route_type:AI Services"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="type:AI Services"></span>
    <span aria-hidden="true" data-pagefind-ignore data-pagefind-meta="category:Portfolio"></span>
    <div class="si page-shell" id="track-overview">
      <div class="sh rv">
        <div class="sl">// Track</div>
        <h1 class="st aisvc-title">How can AI help your business get real work done?</h1>
        <p class="sd aisvc-intro">I turn AI into working tools, safer rollouts, and trained teams for small and mid-size businesses. As a contractor on a monthly retainer, I select and secure the right tools, build automation around your workflows, and stay accountable after launch.</p>
        <p class="page-updated"><span>Last updated</span><time datetime={pageFreshness.lastReviewed}>{reviewedLabel}</time></p>
      </div>

      <div class="aisvc-stats page-stat-grid rv">
        <div class="aisvc-stat page-stat">
          <div class="aisvc-stat-num page-stat-value">{projectCount}+</div>
          <div class="aisvc-stat-label page-stat-label">Projects shipped AI-first</div>
          <div class="page-stat-copy">Every public project in this portfolio — and this site — was designed, built, tested, and released by one person directing AI tooling.</div>
        </div>
        <div class="aisvc-stat page-stat">
          <div class="aisvc-stat-num page-stat-value">{liveAppCount}</div>
          <div class="aisvc-stat-label page-stat-label">Live apps you can open now</div>
          <div class="page-stat-copy">Deployed, working software — not slideware. Open any of them and judge the output yourself.</div>
        </div>
        <div class="aisvc-stat page-stat">
          <div class="aisvc-stat-num page-stat-value">{experienceShort}</div>
          <div class="aisvc-stat-label page-stat-label">Enterprise IT &amp; operations</div>
          <div class="page-stat-copy">Systems administration and healthcare support background — I build for how businesses actually run, not for demos.</div>
        </div>
      </div>
      <div class="aisvc-actions page-actions rv">
        <a href={contactMailto('AI services')} class="btn bp">Start a conversation</a>
        <a href="/resume/" class="btn bg2">Open resume</a>
      </div>
      <SectionJumpNav items={cmdkSections} />
    </div>
    <Divider />

    <div class="si" id="services">
      <h2 class="aisvc-h2">What AI work can I deliver for your business?</h2>
      <div class="aisvc-grid">
        {services.map((s) => (
          <article class="aisvc-card card-enter">
            <div class="aisvc-card-head">
              <span class="aisvc-card-tag">{s.tag}</span>
              <span class="aisvc-card-line">{s.name}</span>
            </div>
            <h3 class="aisvc-card-name">{s.question}</h3>
            <p class="aisvc-card-desc">{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
    <Divider />

    <div class="si" id="engagement">
      <h2 class="aisvc-h2">How does an AI services engagement start?</h2>
      <div class="aisvc-steps">
        {engagementSteps.map((s) => (
          <article class="aisvc-step card-enter">
            <div class="aisvc-step-num">{s.step} · {s.name}</div>
            <h3 class="aisvc-step-name">{s.question}</h3>
            <p class="aisvc-step-desc">{s.desc}</p>
          </article>
        ))}
      </div>
      <div class="aisvc-why rv">
        <p>The economics are the point: AI-augmented work compresses the hours, and the savings pass to you. One retainer costs <strong>a fraction of an agency engagement or a full-time hire</strong>, and it covers implementation, training, and an open problem queue — not a slide deck and an invoice.</p>
      </div>
    </div>
    <Divider />

    <div class="si" id="proof">
      <h2 class="aisvc-h2">What proves this AI-assisted model works?</h2>
      <div class="aisvc-why rv">
        <p>This public portfolio is the proof. For the past year I have treated AI-assisted building as a discipline, not a novelty: <strong>{projectCount}+ public projects</strong> spanning Windows tools, desktop apps, Android apps, browser extensions, and {liveAppCount} live web apps, all researched, built, tested, documented, and released by one person using AI as a force multiplier.</p>
        <p>That is the working model I install in your business. Not a chatbot bolted onto your website — <strong>a faster way to get real work done</strong>, fitted to the workflows you already have and the people who already run them.</p>
        <p><strong>How that works is the honest part:</strong> AI writes the fast draft — scaffolding, boilerplate, test cases, and research sweeps — and I own every decision that ships. The architecture, the security review, the tests, and the judgment about what is good enough are mine. You get working software I stand behind, never raw model output.</p>
        <p>Before AI, I spent {experienceLabel} in enterprise IT and healthcare technology support: tickets, migrations, vendors, uptime, and the operational constraints that make or break a rollout. I have lived the side of the business that most AI consultants have only read about.</p>
        <p>This is a fit for <strong>small and mid-size businesses without a software team</strong> — owners who keep hearing "you should be using AI" and want one accountable person to make it true.</p>
      </div>
    </div>
    <Divider />

    <div class="si" id="ai-contact">
      <h2 class="aisvc-h2">What should you send to get started?</h2>
      <div class="aisvc-why rv">
        <p>Send a short note about your business and the friction you want gone — no preparation needed. The discovery conversation is free, and honest: if AI is the wrong tool for your problem, I will say so.</p>
        <p><a href={contactMailto('AI services')} class="page-inline-link">{contactEmail}</a> · <a href="https://www.linkedin.com/in/matthewryanparker" target="_blank" rel="noopener" class="page-inline-link">LinkedIn</a></p>
      </div>
    </div>
  </main>

  <Footer
    summary="The services here sit on top of a public portfolio of shipped software — browse the catalog, open the live apps, and judge the working model by its output."
    links={[
      { href: '/rss.xml', label: 'RSS' },
      { href: 'https://github.com/SysAdminDoc', label: 'GitHub', external: true },
    ]}
  />
</Base>

<style is:global>
  .aisvc-page{min-height:calc(100vh - 200px)}
  .aisvc-page>.si:not(.page-shell){padding-inline:clamp(20px,5vw,72px)}
  .aisvc-title{font-size:clamp(44px,6vw,72px)!important;background:linear-gradient(120deg,var(--t1),var(--pur));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .aisvc-intro{font-size:18px!important;max-width:720px}
  .aisvc-stats{margin-top:32px;max-width:1080px}
  .aisvc-stat{min-height:100%}
  .aisvc-stat-num{color:var(--pur)}
  .aisvc-actions{margin-top:22px}
  .aisvc-h2{font-size:clamp(26px,3vw,36px);line-height:1.15;letter-spacing:-.035em;color:var(--t1);margin:0 auto 28px;max-width:900px}
  .aisvc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:16px;max-width:1100px;margin:0 auto}
  .aisvc-card{display:flex;flex-direction:column;gap:10px;padding:26px;border:1px solid var(--border-soft);border-radius:12px;background:var(--surface-1);color:var(--t1);box-shadow:var(--shadow-soft);transition:border-color .25s,transform .25s,box-shadow .25s,background-color .25s}
  .aisvc-card:hover{border-color:var(--border-strong);background:var(--surface-strong);transform:translateY(-2px);box-shadow:var(--shadow-sm)}
  .aisvc-card-head{display:flex;align-items:center;justify-content:space-between}
  .aisvc-card-tag{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--pur);padding:3px 8px;border:1px solid color-mix(in srgb, var(--pur) 38%, transparent);border-radius:4px}
  .aisvc-card-line{font-family:var(--mono);font-size:11px;color:var(--t3);text-align:right}
  .aisvc-card-name{font-size:19px;line-height:1.35;font-weight:650;letter-spacing:-.015em;margin:2px 0 0;color:var(--t1)}
  .aisvc-card-desc{color:var(--t2);font-size:14px;line-height:1.6;margin:0;flex:1}
  .aisvc-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;max-width:1100px;margin:0 auto 28px}
  .aisvc-step{display:flex;flex-direction:column;gap:8px;padding:26px;border:1px solid var(--border-soft);border-radius:12px;background:var(--surface-1);box-shadow:var(--shadow-soft)}
  .aisvc-step-num{font-family:var(--mono);font-size:12px;letter-spacing:.15em;color:var(--pur)}
  .aisvc-step-name{font-size:18px;line-height:1.35;font-weight:650;letter-spacing:-.015em;margin:0;color:var(--t1)}
  .aisvc-step-desc{color:var(--t2);font-size:14px;line-height:1.6;margin:0}
  .aisvc-why{max-width:760px;margin:0 auto;color:var(--t2);font-size:17px;line-height:1.75}
  .aisvc-why p{margin-bottom:18px}
  .aisvc-why strong{color:var(--t1);font-weight:600}
</style>
