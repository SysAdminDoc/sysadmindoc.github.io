# Internal static file server for the portfolio container (portfolio-app:80).
# The shared edge Caddy reverse-proxies to this and adds the security headers;
# this instance serves the built site and replicates the machine-endpoint cache
# policy the live smoke expects (GitHub Pages served max-age=600 globally).
:80 {
	root * /srv
	encode zstd gzip

	# Machine-readable endpoints and the service worker: short shared cache,
	# matching the previous GitHub Pages contract that `smoke:live` asserts.
	@cache600 path /status.json /projects.json /releases.json /feed.json /rss.xml /atom.xml /releases.xml /llms.txt /cmdk-data.js /sitemap-index.xml /sitemap-0.xml /sw.js
	header @cache600 Cache-Control "max-age=600"

	# Astro emits content-hashed filenames under /_assets/, so a new build means a
	# new URL and these can be cached permanently.
	@immutable path /_assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Generated social cards keep stable slugs, so they need a real expiry rather
	# than browser heuristics. Matches GENERATED_IMAGE_CACHE_CONTROL in
	# src/data/endpoint-headers.ts, whose value a static build cannot deliver.
	@ogimages path /og.png /og/*
	header @ogimages Cache-Control "public, max-age=86400"

	# Speculation Rules, delivered by header rather than an inline
	# <script type="speculationrules">.
	#
	# The inline form needs 'inline-speculation-rules' in script-src, and WebKit
	# rejects that keyword as an invalid source and logs a console error on every
	# page — which is why the 2026-07-28 attempt was reverted. The header points
	# at a same-origin file instead, so the keyword is never needed and the
	# hash-pinned meta CSP stays exactly as it is.
	#
	# The rules file must be served as application/speculationrules+json or the
	# browser ignores it; Caddy would otherwise infer application/json from the
	# extension.
	@speculationrules path /speculation-rules.json
	header @speculationrules Content-Type "application/speculationrules+json"
	header @speculationrules Cache-Control "public, max-age=600"

	# Reporting API sink. The edge publishes Reporting-Endpoints, and this
	# private sidecar accepts only the bounded POST body on the named route.
	@csp_report path /csp-report
	handle @csp_report {
		header Cache-Control "no-store"
		reverse_proxy csp-reporter:8080
	}

	# The deploy script stamps CSP_POLICY from the built index.html so the
	# response header matches the hash-pinned meta policy and can report real
	# violations. A missing value makes compose fail before an incomplete policy
	# is served.
	header Content-Security-Policy "{$CSP_POLICY}"

	# HTML must revalidate: the URLs are stable, so a cached copy would otherwise
	# pin a visitor to an old build. The service worker owns offline behavior.
	@html path / */ *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"
	# The value is a quoted URL per the Speculation-Rules grammar; backticks let
	# the inner quotes survive the Caddyfile parser.
	header @html Speculation-Rules `"/speculation-rules.json"`

	file_server
	# handle_errors runs a fresh handler chain, so file_server would otherwise
	# write the 404 document with HTTP 200 (a soft 404). Pass the original error
	# status through explicitly so the code survives Caddy upgrades;
	# `npm run smoke:live` fails if a missing path stops returning 404.
	handle_errors {
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}
