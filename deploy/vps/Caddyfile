# Internal static file server for the portfolio container (portfolio-app:80).
# The shared edge Caddy reverse-proxies to this and adds the security headers;
# this instance serves the built site and replicates the machine-endpoint cache
# policy the live smoke expects (GitHub Pages served max-age=600 globally).

# The edge Caddy is this server's only intended client, but about twenty other
# containers share the `web` network with it. Trusting the edge's address alone
# keeps the visitor's address in X-Forwarded-For (with the edge's appended), so
# ntfy and the contact handler can tell visitors apart, while any other
# container's header is replaced with that container's own address. The edge's
# compose file (Contabo-VPS-Ops) pins the address, and deploy-vps stops before
# shipping anything if the edge isn't on it (scripts/lib/edge-address.mjs). See
# NTFY_PROXY_TRUSTED_HOSTS in docker-compose.yml for the other half.
{
	servers {
		trusted_proxies static 172.18.255.254/32
	}
	# Caddy's own log is the container log, which Docker keeps by size (30 MB,
	# SERVER_LOG_MB in src/data/retention.ts). A warning for a response the
	# visitor cut short, or an error from the contact handler, ntfy or the
	# report sink, carries the whole request, the visitor's address in
	# X-Forwarded-For included. So the addresses, port and headers go, the query
	# string is cut, and an IPv4 address in an entry's `error` field is masked
	# (scripts/lib/edge-log-check.mjs; deploy-vps reads it back). A handler
	# error's own text is the entry's message instead, which no filter can
	# reach. Here that can name an upstream's internal address, but not a
	# visitor's: this server's only visitor-facing peer is the edge.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers delete
				request>tls delete
				request>uri regexp \?.*$ ""
				resp_headers delete
				error regexp [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+ x.x.x.x
			}
		}
	}
}

# Lead notifications. The edge forwards https://notify.getparkerai.com here, and
# this block hands it to ntfy on the private compose network, which refuses
# everything without a token. It stays a separate site so the portfolio's CSP
# and cache headers never reach ntfy responses, and flush_interval -1 keeps a
# phone's subscription streaming instead of buffered.
http://notify.getparkerai.com {
	reverse_proxy ntfy:80 {
		flush_interval -1
	}
}

:80 {
	root * /srv
	encode zstd gzip

	# Machine-readable endpoints and the service worker: short shared cache,
	# matching the previous GitHub Pages contract that `smoke:live` asserts.
	@cache600 path /status.json /projects.json /releases.json /feed.json /rss.xml /atom.xml /releases.xml /llms.txt /cmdk-data.js /sitemap-index.xml /sitemap-0.xml /sw.js
	header @cache600 Cache-Control "max-age=600"

	# Astro emits content-hashed filenames under /_assets/, so a new build means a
	# new URL and these can be cached permanently.
	@immutable path /_assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Generated social cards keep stable slugs, so they need a real expiry rather
	# than browser heuristics. Matches GENERATED_IMAGE_CACHE_CONTROL in
	# src/data/endpoint-headers.ts, whose value a static build cannot deliver.
	@ogimages path /og.png /og/*
	header @ogimages Cache-Control "public, max-age=86400"

	# Speculation Rules, delivered by header rather than an inline
	# <script type="speculationrules">.
	#
	# The inline form needs 'inline-speculation-rules' in script-src, and WebKit
	# rejects that keyword as an invalid source and logs a console error on every
	# page — which is why the 2026-07-28 attempt was reverted. The header points
	# at a same-origin file instead, so the keyword is never needed and the
	# hash-pinned meta CSP stays exactly as it is.
	#
	# The rules file must be served as application/speculationrules+json or the
	# browser ignores it; Caddy would otherwise infer application/json from the
	# extension.
	@speculationrules path /speculation-rules.json
	header @speculationrules Content-Type "application/speculationrules+json"
	header @speculationrules Cache-Control "public, max-age=600"

	# The /projects/<Repo>/ pages were removed in 864d3451 and old links still
	# arrive. A repo the catalog knows goes to its GitHub page for good (the
	# redir list is generated from dist/projects.json at deploy time); any other
	# safe name goes to a catalog search for it. The bare /projects/ path, which
	# people trim a link back to, was never a page and goes to the catalog.
	@projects_index path /projects /projects/
	redir @projects_index /catalog/ 301

	@retired_project path_regexp retired_project ^/projects/([A-Za-z0-9._-]+)/?$
	handle @retired_project {
		import project-redirects.caddy
		redir * /catalog/?q={re.retired_project.1} 302
	}

	# Reporting API sink. The edge publishes Reporting-Endpoints, and this
	# private sidecar accepts only the bounded POST body on the named route.
	@csp_report path /csp-report
	handle @csp_report {
		header Cache-Control "no-store"
		reverse_proxy csp-reporter:8080
	}

	# First-party contact form handler. GET /api/contact/token hands the page
	# script a signed timestamp to send back with the form, so submissions are
	# timed on the server's clock; POST /api/contact checks the token, the
	# honeypot, the fields and the rate limits, stores the lead, then notifies
	# the local ntfy. No third-party service in the flow.
	@contact path /api/contact /api/contact/token
	handle @contact {
		header Cache-Control "no-store"
		header Access-Control-Allow-Origin "https://portfolio.getparkerai.com"
		header Access-Control-Allow-Methods "POST"
		header Access-Control-Allow-Headers "Content-Type"
		reverse_proxy contact-handler:8090
	}

	# The deploy script stamps CSP_POLICY from the built index.html so the
	# response header matches the hash-pinned meta policy and can report real
	# violations. A missing value makes compose fail before an incomplete policy
	# is served.
	header Content-Security-Policy "{$CSP_POLICY}"

	# HTML must revalidate: the URLs are stable, so a cached copy would otherwise
	# pin a visitor to an old build. The service worker owns offline behavior.
	@html path / */ *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"
	# The value is a quoted URL per the Speculation-Rules grammar; backticks let
	# the inner quotes survive the Caddyfile parser.
	header @html Speculation-Rules `"/speculation-rules.json"`

	file_server
	# handle_errors runs a fresh handler chain, so file_server would otherwise
	# write the 404 document with HTTP 200 (a soft 404). Pass the original error
	# status through explicitly so the code survives Caddy upgrades;
	# `npm run smoke:live` fails if a missing path stops returning 404.
	handle_errors {
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}
